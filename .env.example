# memory (default), mysql, or auto
DATA_SOURCE=memory
HOST=0.0.0.0
PORT=4000

# Classroom safety limits. HTML crawlers should still wait at least 1 second.
API_RATE_LIMIT_PER_MINUTE=60
API_PREAUTH_RATE_LIMIT_PER_MINUTE=120
HTML_RATE_LIMIT_PER_MINUTE=120

# In-memory mode still reads the CSV files below when available.
MEMORY_CAR_COUNT=5000

# Public daily API keys are derived from this secret, rotate at 00:00 Asia/Seoul,
# and publish tomorrow's key at 23:00. Generate once and never expose this secret.
# If empty, DEALER_PUBLIC_ID_SECRET is used with a separate HMAC domain.
DAILY_API_KEY_SECRET=

# Optional legacy/admin keys. Public classroom clients normally use /api/v1/public-key.
# Never commit a real legacy key. Multiple keys can be comma-separated in UCAR_API_KEYS.
UCAR_API_KEY=

# Separate HMAC secret for non-reversible public dealer aliases (minimum 32 characters).
# Generate once per sandbox, keep it out of Git, and do not share it with crawlers.
DEALER_PUBLIC_ID_SECRET=

# Source CSVs. AREA means an organizational/business area, not a geographic area.
EMPLOYEE_CSV_PATH=/absolute/path/to/biz_employee_master.csv
AREA_CSV_PATH=/absolute/path/to/biz_meta_area_50000.csv
AREA_JOIN_READY_CSV_PATH=/absolute/path/to/biz_meta_area_join_ready.csv
AREA_PARENT_LOOKUP_CSV_PATH=/absolute/path/to/biz_meta_area_parent_lookup.csv
CSV_REQUIRED=true

# These defaults match compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=3308
MYSQL_HOST_PORT=3308
DB_NAME=crawl_lab
DB_USER=crawler
DB_PASSWORD=crawler
DB_CONNECTION_LIMIT=10
DB_MAX_IDLE=10
DB_IDLE_TIMEOUT_MS=60000
DB_CONNECT_TIMEOUT_MS=5000
DB_QUEUE_LIMIT=200

# Optional alternative to the individual DB_* settings.
# DATABASE_URL=mysql://crawler:crawler@127.0.0.1:3308/crawl_lab

# MongoDB is the document mirror for generated listings and change logs.
# compose.yaml binds it to loopback only. Never expose port 27017 publicly.
MONGO_URI=mongodb://crawler:crawler@127.0.0.1:27017/crawl_lab?authSource=admin
MONGO_DB_NAME=crawl_lab

# scripts/seed.mjs defaults. API keys are intentionally preserved during reseed.
SEED_COUNT=100000
SEED_BATCH_SIZE=1000
# Set true only when reseeding this local sandbox; it clears the four generated MongoDB collections.
SEED_RESET_MONGO=true
SEED_LOCK_TIMEOUT_SECONDS=5

# `npm start` launches continuous generation by default. 28 records/4 minutes = about 10,080/day.
AUTO_GENERATE=true
GENERATOR_BATCH_SIZE=28
GENERATOR_INTERVAL_MS=240000
GENERATOR_MYSQL_BATCH_SIZE=500
GENERATOR_MONGO_BATCH_SIZE=500
GENERATOR_MAX_ATTEMPTS=3
GENERATOR_RETRY_DELAY_MS=5000
GENERATOR_RECONCILE_LIMIT=10
# A RUNNING row older than this is treated as interrupted and reconciled.
GENERATOR_STALE_RUN_SECONDS=300
# Grace period for the active batch after SIGINT/SIGTERM; a second signal exits immediately.
GENERATOR_SHUTDOWN_TIMEOUT_MS=60000
